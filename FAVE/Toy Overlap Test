import numpy as np

# time array
fs, T = 4096, 4.0
t = np.linspace(0, T, int(fs*T))

# chirp phase
f0, f1 = 30.0, 500.0
phi = 2*np.pi*(f0*t + (f1-f0)/(2*T)*t**2)
h_gr = np.sin(phi)

# tiny dispersion phase shift
m_eff = 1e10
omega = 2*np.pi*(f0 + (f1-f0)*t/T)
delta_phi = (omega**3 / (2*m_eff**2)) * 1e6  # proxy distance = 1e6m
h_fave = np.sin(phi + delta_phi)

# compute normalised overlap
num = np.vdot(h_gr, h_fave)
den = np.sqrt(np.vdot(h_gr, h_gr) * np.vdot(h_fave, h_fave))
overlap = abs(num/den)
print(f"Overlap = {overlap:.12f}")
